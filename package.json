{
  "name": "axleta",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Axleta — Technology and Advancement. Public corporate website.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:spa": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "data:insights": "node --experimental-strip-types scripts/fetch-insights.ts",
    "build:prerender": "vite build --ssr scripts/prerender.tsx --outDir .prerender --emptyOutDir --logLevel warn",
    "prerender": "node .prerender/prerender.js",
    "postbuild": "npm run build:prerender && npm run prerender"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "16.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
